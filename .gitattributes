* text=auto eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
# Generated audio is small and reproducible from tools/make_audio.py, so it is
# stored as plain git objects instead of LFS.
assets/audio/** -filter -diff -merge binary
